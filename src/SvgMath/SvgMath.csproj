<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SvgMath</RootNamespace>
    <AssemblyName>SvgMath</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyTitle>SvgMathCs</AssemblyTitle>
    <Product>SvgMathCs</Product>
    <Copyright>Copyright © 2015</Copyright>
  </PropertyGroup>

  <!-- Legacy layout: Program.cs exists on disk but was never part of the library build. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configuration\svgmath.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Configuration\fontdata\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE.txt" />
  </ItemGroup>

</Project>
