<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SvgMathTest</RootNamespace>
    <AssemblyName>SvgMathTest</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyTitle>SvgMathTest</AssemblyTitle>
    <Product>SvgMathTest</Product>
    <Authors>SvgMath C# port contributors</Authors>
    <Copyright>Copyright © 2005 Nikolai Grigoriev; Copyright © 2015 SvgMath C# port contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SvgMath\SvgMath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**\*.mml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="svgmath.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
